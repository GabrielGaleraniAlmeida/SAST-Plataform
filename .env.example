# Copy to .env and replace the example password with a unique strong secret.
# Keep POSTGRES_PASSWORD and the password in both database URLs in sync.
POSTGRES_DB=sast_db
POSTGRES_USER=sast_user
POSTGRES_PASSWORD=replace_with_a_unique_strong_password

# API and Celery database connections.
DATABASE_URL=postgresql+asyncpg://sast_user:replace_with_a_unique_strong_password@db:5432/sast_db
DATABASE_SYNC_URL=postgresql+psycopg2://sast_user:replace_with_a_unique_strong_password@db:5432/sast_db

# Internal service URLs.
REDIS_URL=redis://redis:6379/0
ANALYZER_URL=http://analyzer:8002
AI_URL=http://ai:8003

# Leave empty only for local development. Configure outside local development.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SAST_API_KEY=

# Ollama configuration.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_MAX_CONCURRENCY=2

# Application settings.
DEBUG=false
APP_NAME=SAST Platform API
